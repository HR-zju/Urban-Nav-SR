[Unit]
Description= ROS2 Viobot_ctrl Bag Record Service
Requires=ros2-startup.service
After=ros2-startup.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash /root/viobot_ctrl/bash/start_bag.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
KillMode=mixed

StandardOutput=append:/root/record_data/log/bag.log
StandardError=append:/root/record_data/log/bag.log

[Install]
WantedBy=multi-user.target
