[Unit]
Description= ROS2 Viobot_ctrl Camera Service
After=network.target

[Service]
Type=simple
User=root
ExecStart=/bin/bash /root/viobot_ctrl/bash/start_cam.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
KillMode=mixed

StandardOutput=append:/data/upload/log/cam.log
StandardError=append:/data/upload/log/cam.log

[Install]
WantedBy=multi-user.target
