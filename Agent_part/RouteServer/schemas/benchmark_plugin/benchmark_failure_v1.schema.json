{
  "additionalProperties": false,
  "description": "Record one model adapter attempt that did not yield a prediction.\n\nArgs:\n    sample_id: Exact frozen input identity.\n    parent_sample_id: Underlying physical-frame identity.\n    benchmark_profile_id: Benchmark profile attempted by the adapter.\n    model_adapter_id: Adapter implementation identity.\n    failure_code: Stable bounded failure category.\n    detail: Bounded non-secret diagnostic.\n    input_digest: Digest of the attempted model-visible input.",
  "properties": {
    "benchmark_profile_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Benchmark Profile Id",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "failure_code": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Failure Code",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "model_adapter_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Adapter Id",
      "type": "string"
    },
    "parent_sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Parent Sample Id",
      "type": "string"
    },
    "sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "urbannav_benchmark_failure_v1",
      "default": "urbannav_benchmark_failure_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "parent_sample_id",
    "benchmark_profile_id",
    "model_adapter_id",
    "failure_code",
    "input_digest"
  ],
  "title": "BenchmarkFailureV1",
  "type": "object"
}
