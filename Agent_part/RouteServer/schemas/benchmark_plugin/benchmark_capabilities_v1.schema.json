      "type": "string"
    },
    "prediction_geometry_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Prediction Geometry Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "urbannav_benchmark_capabilities_v1",
      "default": "urbannav_benchmark_capabilities_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_input_profiles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Input Profiles",
      "type": "array"
    },
    "supports_arrival": {
      "title": "Supports Arrival",
      "type": "boolean"
    }
  },
  "required": [
    "adapter_id",
    "supported_input_profiles",
    "prediction_geometry_ids",
    "supports_arrival",
