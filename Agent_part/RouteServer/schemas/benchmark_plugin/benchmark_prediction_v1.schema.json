{
  "additionalProperties": false,
  "description": "Store one successful model prediction independent of a dataset plugin.\n\nArgs:\n    sample_id: Exact frozen input identity.\n    parent_sample_id: Underlying physical-frame identity.\n    benchmark_profile_id: Benchmark profile accepted by the adapter.\n    model_adapter_id: Adapter implementation identity.\n    adaptation_mode: Training/adaptation arm reported with the result.\n    prediction_geometry_id: Output coordinate geometry emitted by adapter.\n    trajectory: Cumulative local predicted trajectory with width two or three.\n    time_basis: Whether timestamps are explicit or reuse the reference grid.\n    trajectory_timestamps_s: Explicit timestamps when ``time_basis`` is\n        ``explicit``.\n    arrival_score: Optional calibrated probability in ``[0, 1]``.\n    input_digest: Digest of the exact model-visible input.\n    metadata: Non-secret latency and adapter diagnostics.",
  "properties": {
    "adaptation_mode": {
      "enum": [
        "zero_shot",
        "prompt_only",
        "head_finetune",
        "full_finetune",
        "reference"
      ],
      "title": "Adaptation Mode",
      "type": "string"
    },
    "arrival_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arrival Score"
    },
    "benchmark_profile_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Benchmark Profile Id",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_adapter_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Adapter Id",
      "type": "string"
    },
    "parent_sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Parent Sample Id",
      "type": "string"
    },
    "prediction_geometry_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Prediction Geometry Id",
      "type": "string"
    },
    "sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "urbannav_benchmark_prediction_v1",
      "default": "urbannav_benchmark_prediction_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "time_basis": {
      "enum": [
        "explicit",
        "reference_schedule"
      ],
      "title": "Time Basis",
      "type": "string"
    },
    "trajectory": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "minItems": 1,
      "title": "Trajectory",
      "type": "array"
    },
    "trajectory_timestamps_s": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trajectory Timestamps S"
    }
  },
  "required": [
    "sample_id",
    "parent_sample_id",
    "benchmark_profile_id",
    "model_adapter_id",
    "adaptation_mode",
    "prediction_geometry_id",
    "trajectory",
    "time_basis",
    "input_digest"
  ],
  "title": "BenchmarkPredictionV1",
  "type": "object"
}
