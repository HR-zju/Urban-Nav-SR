        "constraint_code": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Constraint Code",
          "type": "string"
        },
        "effect": {
          "enum": [
            "proceed",
            "slow",
            "yield",
            "wait",
            "stop",
            "detour",
            "avoid",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "kind": {
          "enum": [
            "task",
            "traffic",
            "social",
            "accessibility",
            "local_safety"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "constraint_code",
        "kind",
        "effect"
      ],
      "title": "ApplicableConstraintPayloadV2",
      "type": "object"
    },
