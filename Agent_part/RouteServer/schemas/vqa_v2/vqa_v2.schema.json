    "AlternativeDirectionPayloadV2": {
      "additionalProperties": false,
      "description": "Select an alternative from question-supplied directions.",
      "properties": {
        "alternative_direction_label": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative Direction Label"
        },
        "reason_codes": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "resolved",
            "no_safe_alternative",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "AlternativeDirectionPayloadV2",
      "type": "object"
    },
    "ApplicableConstraintPayloadV2": {
      "additionalProperties": false,
      "description": "Describe one constraint and its affected supplied directions.",
      "properties": {
        "affected_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Affected Direction Labels",
          "type": "array"
