{
  "$defs": {
    "BevRouteEvidenceV4": {
      "additionalProperties": false,
      "description": "Describe presentation properties of one prompt-visible BEV.\n\nThese fields are retained at the reusable observation boundary for VQA V2\ncompatibility.  Reasoning V4.5 never treats them as route-progress,\ntraversability, clearance, or collision-safety supervision.\n\nArgs:\n    frame: Declared BEV presentation frame.\n    ego_forward: Display direction corresponding to ego forward.\n    route_overlay_visible: Whether a route overlay is rendered.\n    route_direction_authority: Whether clear orientation may support a\n        visible task direction.\n    route_progress_authority: Legacy observation metadata ignored by\n        Reasoning V4.5.\n    route_terminal_marker_visible: Legacy presentation metadata ignored by\n        Reasoning V4.5.\n    route_endpoint_semantics: Legacy endpoint provenance ignored by\n        Reasoning V4.5.\n    local_safety_authority: Always false in Stage-A.\n    producer_contract_id: Versioned upstream producer identity.\n    producer_contract_version: Exact upstream producer version.",
      "properties": {
        "ego_forward": {
          "default": "unknown",
          "enum": [
            "up",
            "right",
            "down",
            "left",
            "unknown"
          ],
          "title": "Ego Forward",
          "type": "string"
        },
        "frame": {
          "default": "unknown",
          "enum": [
            "ego",
            "north_up",
            "unknown"
          ],
          "title": "Frame",
          "type": "string"
        },
        "local_safety_authority": {
          "const": false,
          "default": false,
          "title": "Local Safety Authority",
          "type": "boolean"
        },
        "producer_contract_id": {
          "default": "unknown",
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Contract Id",
          "type": "string"
        },
        "producer_contract_version": {
          "default": "unknown",
          "maxLength": 64,
          "minLength": 1,
          "title": "Producer Contract Version",
          "type": "string"
        },
        "route_direction_authority": {
          "default": "none",
          "enum": [
            "none",
            "visual_conditional"
          ],
          "title": "Route Direction Authority",
          "type": "string"
        },
        "route_endpoint_semantics": {
          "default": "unknown",
          "enum": [
            "planned_navigation_goal",
            "recorded_clip_endpoint",
            "crop_boundary",
            "unknown"
          ],
          "title": "Route Endpoint Semantics",
          "type": "string"
        },
        "route_overlay_visible": {
          "default": false,
          "title": "Route Overlay Visible",
          "type": "boolean"
        },
        "route_progress_authority": {
          "default": "none",
          "enum": [
            "none",
            "visual_conditional"
          ],
          "title": "Route Progress Authority",
          "type": "string"
        },
        "route_terminal_marker_visible": {
          "default": false,
          "title": "Route Terminal Marker Visible",
          "type": "boolean"
        }
      },
      "title": "BevRouteEvidenceV4",
      "type": "object"
    },
    "DecisionV4": {
      "additionalProperties": false,
      "description": "Canonical deterministic short-horizon action tuple.",
      "properties": {
        "response": {
          "enum": [
            "proceed",
            "slow",
            "yield",
            "detour",
            "stop"
          ],
          "title": "Response",
          "type": "string"
        },
        "selected_action_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Selected Action Label",
          "type": "string"
        },
        "speed": {
          "enum": [
            "normal",
            "slow",
            "stop"
          ],
          "title": "Speed",
          "type": "string"
        }
      },
      "required": [
        "selected_action_label",
        "speed",
        "response"
      ],
      "title": "DecisionV4",
      "type": "object"
    },
    "DirectionAffordanceV4": {
      "additionalProperties": false,
      "description": "Describe physical FPV executability for one public probe direction.\n\nArgs:\n    direction_label: Direction from the active affordance-probe profile.\n    affordance: Coarse physical executability state.\n    clearance: Coarse visible physical clearance.\n    limiting_factors: Physical factors only; traffic rules are forbidden.",
      "properties": {
        "affordance": {
          "enum": [
            "direct",
            "conditional",
            "blocked",
            "forbidden",
            "unknown"
          ],
          "title": "Affordance",
          "type": "string"
        },
        "clearance": {
          "default": "unknown",
          "enum": [
            "sufficient",
            "narrow",
            "insufficient",
            "unknown"
          ],
          "title": "Clearance",
          "type": "string"
        },
        "direction_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Direction Label",
          "type": "string"
        },
        "limiting_factors": {
          "items": {
            "enum": [
              "static_obstacle",
              "dynamic_occupancy",
              "narrow_clearance",
              "non_walkable_surface",
              "curb",
              "wall",
              "vegetation",
              "occlusion",
              "unknown"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Limiting Factors",
          "type": "array"
        }
      },
      "required": [
        "direction_label",
        "affordance"
      ],
      "title": "DirectionAffordanceV4",
      "type": "object"
    },
    "DirectionContextV4": {
      "additionalProperties": false,
      "description": "Select approved action and affordance-probe profiles.\n\nArgs:\n    action_profile_id: Canonical fine action-profile identifier.\n    action_profile_version: Exact action-profile version.\n    affordance_probe_profile_id: Canonical probe identifier.\n    affordance_probe_profile_version: Exact probe version.",
      "properties": {
        "action_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action Profile Id",
          "type": "string"
        },
        "action_profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Action Profile Version",
          "type": "string"
        },
        "affordance_probe_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Affordance Probe Profile Id",
          "type": "string"
        },
        "affordance_probe_profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Affordance Probe Profile Version",
          "type": "string"
        }
      },
      "required": [
        "action_profile_id",
        "action_profile_version",
        "affordance_probe_profile_id",
        "affordance_probe_profile_version"
      ],
      "title": "DirectionContextV4",
      "type": "object"
    },
    "DirectionSupervisionV4": {
      "additionalProperties": false,
      "description": "Carry one complete deterministic direction label.",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "bin_mode": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Bin Mode",
          "type": "string"
        },
        "choice": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "derivation_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Derivation Version",
          "type": "string"
        },
        "label_index": {
          "minimum": 0,
          "title": "Label Index",
          "type": "integer"
        },
        "label_name": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Label Name",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "source": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "label_index",
        "label_name",
        "choice",
        "source",
        "bin_mode",
        "derivation_version"
      ],
      "title": "DirectionSupervisionV4",
      "type": "object"
    },
    "EvidenceCatalogEntryV4": {
      "additionalProperties": false,
      "description": "Describe one prompt-visible raw input item.\n\nArgs:\n    ref: Stable input-envelope reference.\n    modality: Input modality.\n    summary: Optional prompt-visible summary.\n    attributes: Prompt-visible producer metadata.\n    bev_route_evidence: Optional BEV presentation declaration.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "bev_route_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/BevRouteEvidenceV4"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modality": {
          "enum": [
            "instruction",
            "fpv",
            "bev",
            "goal",
            "goal_image",
            "pixel_goal",
            "waypoint"
          ],
          "title": "Modality",
          "type": "string"
        },
        "ref": {
          "maxLength": 160,
          "minLength": 5,
          "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
          "title": "Ref",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "ref",
        "modality"
      ],
      "title": "EvidenceCatalogEntryV4",
      "type": "object"
    },
    "InputModalitiesV4": {
      "additionalProperties": false,
      "description": "Record which Stage-A inputs are present.\n\nArgs:\n    fpv: Current FPV is mandatory.\n    history_fpv: One or more history FPV images are input only.\n    instruction: An instruction is visible.\n    bev: A BEV image is visible.\n    goal_image: A goal image is visible.\n    pixel_goal: A pixel goal is visible.\n    waypoint: A waypoint is visible.",
      "properties": {
        "bev": {
          "default": false,
          "title": "Bev",
          "type": "boolean"
        },
        "fpv": {
          "const": true,
          "default": true,
          "title": "Fpv",
          "type": "boolean"
        },
        "goal_image": {
          "default": false,
          "title": "Goal Image",
          "type": "boolean"
        },
        "history_fpv": {
          "default": false,
          "title": "History Fpv",
          "type": "boolean"
        },
        "instruction": {
          "default": false,
          "title": "Instruction",
          "type": "boolean"
        },
        "pixel_goal": {
          "default": false,
          "title": "Pixel Goal",
          "type": "boolean"
        },
        "waypoint": {
          "default": false,
          "title": "Waypoint",
          "type": "boolean"
        }
      },
      "title": "InputModalitiesV4",
      "type": "object"
    },
    "InteractionConstraintGroundingV4": {
      "additionalProperties": false,
      "description": "Collect high-level behavior constraints without source binding.\n\nArgs:\n    constraints: Current restrictions that can alter the short action.",
      "properties": {
        "constraints": {
          "items": {
            "$ref": "#/$defs/InteractionConstraintV4"
          },
          "maxItems": 24,
          "title": "Constraints",
          "type": "array"
        }
      },
      "title": "InteractionConstraintGroundingV4",
      "type": "object"
    },
    "InteractionConstraintV4": {
      "additionalProperties": false,
      "description": "Represent one high-level current behavior restriction.\n\nArgs:\n    kind: Open high-level behavior-constraint category.\n    status: Whether the restriction is currently applicable or uncertain.\n    effect: Required behavior response family.\n    affected_direction_labels: Empty for a global constraint, otherwise\n        the affected public action subset.",
      "properties": {
        "affected_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Affected Direction Labels",
          "type": "array"
        },
        "effect": {
          "enum": [
            "slow",
            "yield",
            "stop",
            "avoid"
          ],
          "title": "Effect",
          "type": "string"
        },
        "kind": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "applicable",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status",
        "effect"
      ],
      "title": "InteractionConstraintV4",
      "type": "object"
    },
    "LocalTraversabilityV4": {
      "additionalProperties": false,
      "description": "Collect physical affordances for the public probe vocabulary.\n\nArgs:\n    direction_affordances: At most one record per probe direction.",
      "properties": {
        "direction_affordances": {
          "items": {
            "$ref": "#/$defs/DirectionAffordanceV4"
          },
          "maxItems": 24,
          "title": "Direction Affordances",
          "type": "array"
        }
      },
      "title": "LocalTraversabilityV4",
      "type": "object"
    },
    "NavigationContextGroundingV4": {
      "additionalProperties": false,
      "description": "Store only the visible Stage-A route direction context.\n\nArgs:\n    task_direction: Nullable prompt-visible movement direction.",
      "properties": {
        "task_direction": {
          "$ref": "#/$defs/TaskDirectionV4"
        }
      },
      "required": [
        "task_direction"
      ],
      "title": "NavigationContextGroundingV4",
      "type": "object"
    },
    "ReasoningTargetV4": {
      "additionalProperties": false,
      "description": "Wrap the canonical trace used as a training audit sidecar.\n\nArgs:\n    reasoning: Exact six-section V4.5 trace.  V4.5 has no Finish object.",
      "properties": {
        "reasoning": {
          "$ref": "#/$defs/ReasoningTraceV4"
        }
      },
      "required": [
        "reasoning"
      ],
      "title": "ReasoningTargetV4",
      "type": "object"
    },
    "ReasoningTraceV4": {
      "additionalProperties": false,
      "description": "Canonical six-section shared-input Reasoning V4.5 trace.\n\nArgs:\n    schema_version: Exact V4.5 semantic contract stamp.\n    task_grounding: Deterministically normalized task.\n    scene_grounding: Coarse visible scene summary.\n    local_traversability: Physical direction affordances.\n    navigation_context_grounding: Visible task direction.\n    interaction_constraint_grounding: High-level behavior restrictions.\n    decision: One consistent short-horizon action tuple.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionV4"
        },
        "interaction_constraint_grounding": {
          "$ref": "#/$defs/InteractionConstraintGroundingV4"
        },
        "local_traversability": {
          "$ref": "#/$defs/LocalTraversabilityV4"
        },
        "navigation_context_grounding": {
          "$ref": "#/$defs/NavigationContextGroundingV4"
        },
        "scene_grounding": {
          "$ref": "#/$defs/SceneGroundingV4"
        },
        "schema_version": {
          "const": "urbannav_reasoning_trace_v4_5",
          "default": "urbannav_reasoning_trace_v4_5",
          "title": "Schema Version",
          "type": "string"
        },
        "task_grounding": {
          "$ref": "#/$defs/TaskGroundingV4"
        }
      },
      "required": [
        "task_grounding",
        "scene_grounding",
        "local_traversability",
        "navigation_context_grounding",
        "interaction_constraint_grounding",
        "decision"
      ],
      "title": "ReasoningTraceV4",
      "type": "object"
    },
    "SceneGroundingV4": {
      "additionalProperties": false,
      "description": "Summarize the visible navigation environment without object binding.\n\nArgs:\n    scene_type: Open coarse scene code such as ``urban_sidewalk``.\n    walkable_support: Open visible support code such as ``crosswalk``.\n    key_entities: Open categories that materially affect local navigation.\n    traffic_context: Open coarse traffic-control context code.",
      "properties": {
        "key_entities": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Key Entities",
          "type": "array"
        },
        "scene_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Scene Type",
          "type": "string"
        },
        "traffic_context": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Traffic Context",
          "type": "string"
        },
        "walkable_support": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Walkable Support",
          "type": "string"
        }
      },
      "required": [
        "scene_type",
        "walkable_support",
        "traffic_context"
      ],
      "title": "SceneGroundingV4",
      "type": "object"
    },
    "TaskDirectionV4": {
      "additionalProperties": false,
      "description": "Store the visible short-horizon route direction.\n\nArgs:\n    status: Whether a prompt-visible direction is usable.\n    direction: Public moving direction when status is ``aligned``.",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "status": {
          "enum": [
            "aligned",
            "conflict",
            "not_visible",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "TaskDirectionV4",
      "type": "object"
    },
    "TaskGroundingV4": {
      "additionalProperties": false,
      "description": "Store a canonical task taxonomy derived from the instruction.\n\nArgs:\n    objective: Versioned normalized task objective.\n    requirements: Explicit task-specific requirements only.\n    ambiguities: Material task ambiguities, empty for the common template.",
      "properties": {
        "ambiguities": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Ambiguities",
          "type": "array"
        },
        "objective": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Objective",
          "type": "string"
        },
        "requirements": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "objective"
      ],
      "title": "TaskGroundingV4",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Cross-repository compact FullCoT view consumed by ms-swift.\n\nReview previews and formal training rows share one syntax, but only formal\nrows may be adapted into LM-loss examples.  Formal rows are fail-closed on\nevery eligibility axis.\n\nArgs:\n    schema_version: Exact V4.5 training-view stamp.\n    reasoning_contract_schema_digest: Exact canonical contract digest.\n    sample_id: Stable view identity.\n    source_group_id: Parent source group.\n    split_group_id: Leakage-safe split group.\n    dataset_source: Dataset family.\n    view_type: Compact FullCoT SFT.\n    release_track: Review-only or formal-training track.\n    audit_id: Exact action audit.\n    review_status: Derived review state.\n    training_status: Derived training state.\n    training_eligible: Derived eligibility bit.\n    images: Ordered prompt images.\n    image_roles: Addressable image roles.\n    instruction: Optional visible instruction.\n    model_visible_context: Additional visible context.\n    evidence_catalog: Prompt-visible input catalog.\n    input_modalities: Input availability flags.\n    direction_context: Public direction profiles.\n    assistant_text: Canonical compact six-section text.\n    reasoning_target: Exact six-section typed target.\n    full_cot_renderer_id: Exact compact renderer.\n    prompt_profile_id: Student prompt profile.\n    prompt_policy_digest: Exact student prompt-policy digest.\n    direction_supervision: Complete private direction stamp.\n    trajectory_ego_t: Optional existing System1 target.\n    trajectory_policy: Existing System1 trajectory contract.\n    action_mask: Optional existing System1 mask.\n    metadata: Non-semantic export metadata.",
  "properties": {
    "action_mask": {
      "anyOf": [
        {
          "items": {
            "type": "boolean"
          },
          "type": "array"
        },
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Mask"
    },
    "assistant_text": {
      "minLength": 1,
      "title": "Assistant Text",
      "type": "string"
    },
    "audit_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Id"
    },
    "dataset_source": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Source",
      "type": "string"
    },
    "direction_context": {
      "$ref": "#/$defs/DirectionContextV4"
    },
    "direction_supervision": {
      "$ref": "#/$defs/DirectionSupervisionV4"
    },
    "evidence_catalog": {
      "items": {
        "$ref": "#/$defs/EvidenceCatalogEntryV4"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence Catalog",
      "type": "array"
    },
    "full_cot_renderer_id": {
      "const": "reasoning_v4_compact_full_cot_renderer_v2",
      "default": "reasoning_v4_compact_full_cot_renderer_v2",
      "title": "Full Cot Renderer Id",
      "type": "string"
    },
    "image_roles": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Image Roles",
      "type": "array"
    },
    "images": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Images",
      "type": "array"
    },
    "input_modalities": {
      "$ref": "#/$defs/InputModalitiesV4"
    },
    "instruction": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instruction"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_visible_context": {
      "additionalProperties": true,
      "title": "Model Visible Context",
      "type": "object"
    },
    "prompt_policy_digest": {
      "maxLength": 64,
      "minLength": 64,
