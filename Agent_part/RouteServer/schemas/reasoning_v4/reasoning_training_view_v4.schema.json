{
  "$defs": {
    "CriticalUncertaintyV4": {
      "additionalProperties": false,
      "description": "Represent a material unresolved issue without pseudo-confidence.\n\nArgs:\n    uncertainty_ref: Neutral sample-local uncertainty identifier.\n    uncertainty_code: Open semantic code for the unresolved issue.\n    uncertainty_type: Closed uncertainty family.\n    affected_direction_labels: Public directions affected by the issue.\n    resolution_policy: Closed conservative response policy.\n    evidence_refs: Raw visible evidence addresses.",
      "properties": {
        "affected_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Affected Direction Labels",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "resolution_policy": {
          "enum": [
            "continue_observing",
            "slow",
            "yield",
            "wait",
            "stop"
          ],
          "title": "Resolution Policy",
          "type": "string"
        },
        "uncertainty_code": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Uncertainty Code",
          "type": "string"
        },
        "uncertainty_ref": {
          "maxLength": 32,
          "minLength": 15,
          "pattern": "^uncertainty\\.u[0-9]{2,}$",
          "title": "Uncertainty Ref",
          "type": "string"
        },
        "uncertainty_type": {
          "enum": [
            "task",
            "perception",
            "temporal",
            "cross_modal",
            "rule_applicability"
          ],
          "title": "Uncertainty Type",
          "type": "string"
        }
      },
      "required": [
        "uncertainty_ref",
        "uncertainty_code",
        "uncertainty_type",
        "resolution_policy",
        "evidence_refs"
      ],
      "title": "CriticalUncertaintyV4",
      "type": "object"
    },
    "DecisionV4": {
      "additionalProperties": false,
      "description": "Canonical decision after profile-owned motion composition.\n\nArgs:\n    motion: Coarse motion deterministically projected by DirectionProfile.\n    **inherited: All weak proposal fields from :class:`DecisionProposalV4`.",
      "properties": {
        "critical_uncertainties": {
          "items": {
            "$ref": "#/$defs/CriticalUncertaintyV4"
          },
          "maxItems": 12,
          "title": "Critical Uncertainties",
          "type": "array"
        },
        "decision_type": {
          "enum": [
            "navigate",
            "stop",
            "finish",
            "request_user",
            "request_replan"
          ],
          "title": "Decision Type",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "fallback": {
          "enum": [
            "continue",
            "slow",
            "stop",
            "request_clarification",
            "request_replan",
            "unknown"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "motion": {
          "enum": [
            "go_straight",
            "turn_left",
            "turn_right",
            "stop"
          ],
          "title": "Motion",
          "type": "string"
        },
        "navigation_intent_direction_label": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Navigation Intent Direction Label"
        },
        "selected_action_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Selected Action Label",
          "type": "string"
        },
        "social_action": {
          "enum": [
            "none",
            "yield",
            "wait",
            "follow",
            "pass_left",
            "pass_right",
            "detour",
            "unknown"
          ],
          "title": "Social Action",
          "type": "string"
        },
        "speed": {
          "enum": [
            "normal",
            "slow",
            "stop"
          ],
          "title": "Speed",
          "type": "string"
        },
        "support_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 8,
            "pattern": "^(task\\.goal|nav\\.task_direction|requirement\\.[a-z0-9_]+|ambiguity\\.[a-z0-9_]+|entity\\.e[0-9]{2,}|control\\.c[0-9]{2,}|alignment\\.a[0-9]{2,}|constraint\\.k[0-9]{2,}|uncertainty\\.u[0-9]{2,})$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Support Refs",
          "type": "array"
        }
      },
      "required": [
        "decision_type",
        "selected_action_label",
        "speed",
        "social_action",
        "fallback",
        "evidence_refs",
        "motion"
      ],
      "title": "DecisionV4",
      "type": "object"
    },
    "DirectionAffordanceV4": {
      "additionalProperties": false,
      "description": "Describe FPV support for one public direction label.\n\nArgs:\n    direction_label: Label selected from the public direction vocabulary.\n    support_type: Open semantic code for the visible walking support.\n    affordance: Categorical local executability judgment.\n    clearance: Coarse visual clearance category.\n    limiting_factor_codes: Open codes explaining a non-direct judgment.\n    evidence_status: Categorical support state, not a probability.\n    evidence_refs: Raw FPV evidence addresses supporting the judgment.",
      "properties": {
        "affordance": {
          "enum": [
            "direct",
            "conditional",
            "blocked",
            "forbidden",
            "unknown"
          ],
          "title": "Affordance",
          "type": "string"
        },
        "clearance": {
          "default": "unknown",
          "enum": [
            "sufficient",
            "narrow",
            "insufficient",
            "unknown"
          ],
          "title": "Clearance",
          "type": "string"
        },
        "direction_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Direction Label",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "supported",
            "ambiguous",
            "insufficient"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "limiting_factor_codes": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Limiting Factor Codes",
          "type": "array"
        },
        "support_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Support Type",
          "type": "string"
        }
      },
      "required": [
        "direction_label",
        "support_type",
        "affordance",
        "evidence_status",
        "evidence_refs"
      ],
      "title": "DirectionAffordanceV4",
      "type": "object"
    },
    "DirectionOutputSpaceV4": {
      "additionalProperties": false,
      "description": "Expose an approved direction vocabulary without the selected label.\n\nArgs:\n    profile_id: Exact approved direction-profile identifier.\n    profile_version: Exact profile version.\n    allowed_labels: Complete ordered label vocabulary owned by the profile.",
      "properties": {
        "allowed_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowed Labels",
          "type": "array"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "allowed_labels"
      ],
      "title": "DirectionOutputSpaceV4",
      "type": "object"
    },
    "DirectionSupervisionV4": {
      "additionalProperties": false,
      "description": "Carry one complete, profile-stamped deterministic direction label.",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "bin_mode": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Bin Mode",
          "type": "string"
        },
        "choice": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "derivation_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Derivation Version",
          "type": "string"
        },
        "label_index": {
          "minimum": 0,
          "title": "Label Index",
          "type": "integer"
        },
        "label_name": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Label Name",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "source": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "label_index",
        "label_name",
        "choice",
        "source",
        "bin_mode",
        "derivation_version"
      ],
      "title": "DirectionSupervisionV4",
      "type": "object"
    },
    "EvidenceCatalogEntryV4": {
      "additionalProperties": false,
      "description": "Describe one raw prompt-visible evidence item.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "modality": {
          "enum": [
            "instruction",
            "fpv",
            "bev",
            "goal",
            "goal_image",
            "pixel_goal",
            "waypoint"
          ],
          "title": "Modality",
          "type": "string"
        },
        "ref": {
          "maxLength": 160,
          "minLength": 5,
          "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
          "title": "Ref",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "ref",
        "modality"
      ],
      "title": "EvidenceCatalogEntryV4",
      "type": "object"
    },
    "FinishDirectionV4": {
      "additionalProperties": false,
      "description": "Expose exactly one trainable demonstrated direction label.",
      "properties": {
        "label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "FinishDirectionV4",
      "type": "object"
    },
    "FinishV4": {
      "additionalProperties": false,
      "description": "Project the current Decision and deterministic demonstrated direction.",
      "properties": {
        "decision_type": {
          "enum": [
            "navigate",
            "stop",
            "finish",
            "request_user",
            "request_replan"
          ],
          "title": "Decision Type",
          "type": "string"
        },
        "demonstrated_direction": {
          "$ref": "#/$defs/FinishDirectionV4"
        },
        "motion": {
          "enum": [
            "go_straight",
            "turn_left",
            "turn_right",
            "stop"
          ],
          "title": "Motion",
          "type": "string"
        },
        "schema_version": {
          "const": "urbannav_finish_v4_2",
          "default": "urbannav_finish_v4_2",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_action_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Selected Action Label",
          "type": "string"
        },
        "social_action": {
          "enum": [
            "none",
            "yield",
            "wait",
            "follow",
            "pass_left",
            "pass_right",
            "detour",
            "unknown"
          ],
          "title": "Social Action",
          "type": "string"
        },
        "speed": {
          "enum": [
            "normal",
            "slow",
            "stop"
          ],
          "title": "Speed",
          "type": "string"
        }
      },
      "required": [
        "decision_type",
        "motion",
        "speed",
        "social_action",
        "selected_action_label",
        "demonstrated_direction"
      ],
      "title": "FinishV4",
      "type": "object"
    },
    "GoalAlignmentV4": {
      "additionalProperties": false,
      "description": "Align a task goal to open target semantics and public directions.",
      "properties": {
        "candidate_target_descriptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Candidate Target Descriptions",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "goal_ref": {
          "const": "task.goal",
          "default": "task.goal",
          "title": "Goal Ref",
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved",
            "ambiguous",
            "not_visible",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "supported_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Supported Direction Labels",
          "type": "array"
        },
        "target_description": {
          "anyOf": [
            {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Description"
        }
      },
      "required": [
        "status",
        "evidence_refs"
      ],
      "title": "GoalAlignmentV4",
      "type": "object"
    },
    "InputModalitiesV4": {
      "additionalProperties": false,
      "description": "Record which Stage-A inputs are actually present for one sample.",
      "properties": {
        "bev": {
          "default": false,
          "title": "Bev",
          "type": "boolean"
        },
        "fpv": {
          "const": true,
          "default": true,
          "title": "Fpv",
          "type": "boolean"
        },
        "goal_image": {
          "default": false,
          "title": "Goal Image",
          "type": "boolean"
        },
        "history_fpv": {
          "default": false,
          "title": "History Fpv",
          "type": "boolean"
        },
        "instruction": {
          "default": false,
          "title": "Instruction",
          "type": "boolean"
        },
        "pixel_goal": {
          "default": false,
          "title": "Pixel Goal",
          "type": "boolean"
        },
        "waypoint": {
          "default": false,
          "title": "Waypoint",
          "type": "boolean"
        }
      },
      "title": "InputModalitiesV4",
      "type": "object"
    },
    "InteractionConstraintGroundingV4": {
      "additionalProperties": false,
      "description": "Collect direction-scoped interaction and rule constraints.",
      "properties": {
        "constraints": {
          "items": {
            "$ref": "#/$defs/InteractionConstraintV4"
          },
          "maxItems": 24,
          "title": "Constraints",
          "type": "array"
        }
      },
      "title": "InteractionConstraintGroundingV4",
      "type": "object"
    },
    "InteractionConstraintV4": {
      "additionalProperties": false,
      "description": "Convert visible evidence into a global or subset behavior constraint.\n\nAn empty ``affected_direction_labels`` list means that the constraint applies\nto the current action globally. A non-empty list identifies only the affected\nsubset; it must not enumerate the complement or expand an ``all_moving``\npseudo-scope.",
      "properties": {
        "affected_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Affected Direction Labels",
          "type": "array"
        },
        "constraint_ref": {
          "maxLength": 32,
          "minLength": 14,
          "pattern": "^constraint\\.k[0-9]{2,}$",
          "title": "Constraint Ref",
          "type": "string"
        },
        "effect": {
          "enum": [
            "slow",
            "yield",
            "stop",
            "avoid"
          ],
          "title": "Effect",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "enum": [
            "task",
            "social",
            "traffic",
            "accessibility",
            "local_safety"
          ],
          "title": "Kind",
          "type": "string"
        },
        "relation": {
          "enum": [
            "controls_current_path",
            "occupies_candidate_path",
            "crosses_candidate_path",
            "approaches_candidate_path",
            "near_candidate_path",
            "reduces_clearance",
            "blocks_candidate_path",
            "conflicts_with_requirement",
            "unknown"
          ],
          "title": "Relation",
          "type": "string"
        },
        "source_state": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source State",
          "type": "string"
        },
        "source_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "applicable",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "constraint_ref",
        "kind",
        "source_type",
        "source_state",
        "relation",
        "status",
        "effect",
        "evidence_refs"
      ],
      "title": "InteractionConstraintV4",
      "type": "object"
    },
    "LocalTraversabilityV4": {
      "additionalProperties": false,
      "description": "Judge the public direction vocabulary from current FPV evidence.",
      "properties": {
        "direction_affordances": {
          "items": {
            "$ref": "#/$defs/DirectionAffordanceV4"
          },
          "maxItems": 24,
          "title": "Direction Affordances",
          "type": "array"
        }
      },
      "title": "LocalTraversabilityV4",
      "type": "object"
    },
    "NavigationContextGroundingV4": {
      "additionalProperties": false,
      "description": "Ground visible task sources to the public direction vocabulary.",
      "properties": {
        "goal_alignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalAlignmentV4"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_alignments": {
          "items": {
            "$ref": "#/$defs/NavigationSourceAlignmentV4"
          },
          "maxItems": 16,
          "title": "Source Alignments",
          "type": "array"
        },
        "task_direction": {
          "$ref": "#/$defs/TaskDirectionV4"
        }
      },
      "required": [
        "task_direction"
      ],
      "title": "NavigationContextGroundingV4",
      "type": "object"
    },
    "NavigationSourceAlignmentV4": {
      "additionalProperties": false,
      "description": "Record evidence-supported directions for one visible task source.",
      "properties": {
        "alignment_ref": {
          "maxLength": 32,
          "minLength": 13,
          "pattern": "^alignment\\.a[0-9]{2,}$",
          "title": "Alignment Ref",
          "type": "string"
        },
        "alignment_role": {
          "enum": [
            "task_intent",
            "route_intent",
            "local_safety_bias"
          ],
          "title": "Alignment Role",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_ref": {
          "maxLength": 160,
          "minLength": 5,
          "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
          "title": "Source Ref",
          "type": "string"
        },
        "status": {
          "enum": [
            "supports",
            "conflicts",
            "not_visible",
            "insufficient"
          ],
          "title": "Status",
          "type": "string"
        },
        "supported_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Supported Direction Labels",
          "type": "array"
        }
      },
      "required": [
        "alignment_ref",
        "source_ref",
        "alignment_role",
        "status",
        "evidence_refs"
      ],
      "title": "NavigationSourceAlignmentV4",
      "type": "object"
    },
    "ReasoningTargetV4": {
      "additionalProperties": false,
      "description": "Pair a canonical Reasoning V4.2 trace with its finish projection.",
      "properties": {
        "finish": {
          "$ref": "#/$defs/FinishV4"
        },
