{
  "$defs": {
    "DecisionV4": {
      "additionalProperties": false,
      "description": "Canonical deterministic short-horizon action tuple.",
      "properties": {
        "response": {
          "enum": [
            "proceed",
            "slow",
            "yield",
            "detour",
            "stop"
          ],
          "title": "Response",
          "type": "string"
        },
        "selected_action_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Selected Action Label",
          "type": "string"
        },
        "speed": {
          "enum": [
            "normal",
            "slow",
            "stop"
          ],
          "title": "Speed",
          "type": "string"
        }
      },
      "required": [
        "selected_action_label",
        "speed",
        "response"
      ],
      "title": "DecisionV4",
      "type": "object"
    },
    "DirectionAffordanceV4": {
      "additionalProperties": false,
      "description": "Describe physical FPV executability for one public probe direction.\n\nArgs:\n    direction_label: Direction from the active affordance-probe profile.\n    affordance: Coarse physical executability state.\n    clearance: Coarse visible physical clearance.\n    limiting_factors: Physical factors only; traffic rules are forbidden.",
      "properties": {
        "affordance": {
          "enum": [
            "direct",
            "conditional",
            "blocked",
            "forbidden",
            "unknown"
          ],
          "title": "Affordance",
          "type": "string"
        },
        "clearance": {
          "default": "unknown",
          "enum": [
            "sufficient",
            "narrow",
            "insufficient",
            "unknown"
          ],
          "title": "Clearance",
          "type": "string"
        },
        "direction_label": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Direction Label",
          "type": "string"
        },
        "limiting_factors": {
          "items": {
            "enum": [
              "static_obstacle",
              "dynamic_occupancy",
              "narrow_clearance",
              "non_walkable_surface",
              "curb",
              "wall",
              "vegetation",
              "occlusion",
              "unknown"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Limiting Factors",
          "type": "array"
        }
      },
      "required": [
        "direction_label",
        "affordance"
      ],
      "title": "DirectionAffordanceV4",
      "type": "object"
    },
    "InteractionConstraintGroundingV4": {
      "additionalProperties": false,
      "description": "Collect high-level behavior constraints without source binding.\n\nArgs:\n    constraints: Current restrictions that can alter the short action.",
      "properties": {
        "constraints": {
          "items": {
            "$ref": "#/$defs/InteractionConstraintV4"
          },
          "maxItems": 24,
          "title": "Constraints",
          "type": "array"
        }
      },
      "title": "InteractionConstraintGroundingV4",
      "type": "object"
    },
    "InteractionConstraintV4": {
      "additionalProperties": false,
      "description": "Represent one high-level current behavior restriction.\n\nArgs:\n    kind: Open high-level behavior-constraint category.\n    status: Whether the restriction is currently applicable or uncertain.\n    effect: Required behavior response family.\n    affected_direction_labels: Empty for a global constraint, otherwise\n        the affected public action subset.",
      "properties": {
        "affected_direction_labels": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Affected Direction Labels",
          "type": "array"
        },
        "effect": {
          "enum": [
            "slow",
            "yield",
            "stop",
            "avoid"
          ],
          "title": "Effect",
          "type": "string"
        },
        "kind": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "applicable",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status",
        "effect"
      ],
      "title": "InteractionConstraintV4",
      "type": "object"
    },
    "LocalTraversabilityV4": {
      "additionalProperties": false,
      "description": "Collect physical affordances for the public probe vocabulary.\n\nArgs:\n    direction_affordances: At most one record per probe direction.",
      "properties": {
        "direction_affordances": {
          "items": {
            "$ref": "#/$defs/DirectionAffordanceV4"
          },
          "maxItems": 24,
          "title": "Direction Affordances",
          "type": "array"
        }
      },
      "title": "LocalTraversabilityV4",
      "type": "object"
    },
    "NavigationContextGroundingV4": {
      "additionalProperties": false,
      "description": "Store only the visible Stage-A route direction context.\n\nArgs:\n    task_direction: Nullable prompt-visible movement direction.",
      "properties": {
        "task_direction": {
          "$ref": "#/$defs/TaskDirectionV4"
        }
      },
      "required": [
        "task_direction"
      ],
      "title": "NavigationContextGroundingV4",
      "type": "object"
    },
    "ReasoningTraceV4": {
      "additionalProperties": false,
      "description": "Canonical six-section shared-input Reasoning V4.6 trace.\n\nArgs:\n    schema_version: Exact V4.6 semantic contract stamp.\n    task_grounding: Deterministically normalized task.\n    scene_grounding: Coarse visible scene summary.\n    local_traversability: Physical direction affordances.\n    navigation_context_grounding: Visible task direction.\n    interaction_constraint_grounding: High-level behavior restrictions.\n    decision: One consistent short-horizon action tuple.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionV4"
        },
        "interaction_constraint_grounding": {
          "$ref": "#/$defs/InteractionConstraintGroundingV4"
        },
        "local_traversability": {
          "$ref": "#/$defs/LocalTraversabilityV4"
        },
        "navigation_context_grounding": {
          "$ref": "#/$defs/NavigationContextGroundingV4"
        },
        "scene_grounding": {
          "$ref": "#/$defs/SceneGroundingV4"
        },
        "schema_version": {
          "const": "urbannav_reasoning_trace_v4_6",
          "default": "urbannav_reasoning_trace_v4_6",
          "title": "Schema Version",
          "type": "string"
        },
        "task_grounding": {
          "$ref": "#/$defs/TaskGroundingV4"
        }
      },
      "required": [
        "task_grounding",
        "scene_grounding",
        "local_traversability",
        "navigation_context_grounding",
        "interaction_constraint_grounding",
        "decision"
      ],
      "title": "ReasoningTraceV4",
      "type": "object"
    },
    "SceneGroundingV4": {
      "additionalProperties": false,
      "description": "Summarize the visible navigation environment without object binding.\n\nArgs:\n    scene_type: Open coarse scene code such as ``urban_sidewalk``.\n    walkable_support: Open visible support code such as ``crosswalk``.\n    key_entities: Open categories that materially affect local navigation.\n    traffic_context: Open coarse traffic-control context code.",
      "properties": {
        "key_entities": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Key Entities",
          "type": "array"
        },
        "scene_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Scene Type",
          "type": "string"
        },
        "traffic_context": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Traffic Context",
          "type": "string"
        },
        "walkable_support": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Walkable Support",
          "type": "string"
        }
      },
      "required": [
        "scene_type",
        "walkable_support",
        "traffic_context"
      ],
      "title": "SceneGroundingV4",
      "type": "object"
    },
    "TaskDirectionV4": {
      "additionalProperties": false,
      "description": "Store the visible short-horizon route direction.\n\nArgs:\n    status: Whether a prompt-visible direction is usable.\n    source: Minimal visible authority for an aligned direction.\n    direction: Public moving direction when status is ``aligned``.",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "source": {
          "enum": [
            "bev_route",
            "instruction",
            "none"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "aligned",
            "conflict",
            "not_visible",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "TaskDirectionV4",
      "type": "object"
    },
    "TaskGroundingV4": {
      "additionalProperties": false,
      "description": "Store a canonical task taxonomy derived from the instruction.\n\nArgs:\n    objective: Versioned normalized task objective.\n    requirements: Explicit task-specific requirements only.\n    ambiguities: Material task ambiguities, empty for the common template.",
      "properties": {
        "ambiguities": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Ambiguities",
          "type": "array"
        },
        "objective": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Objective",
          "type": "string"
        },
        "requirements": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "objective"
      ],
      "title": "TaskGroundingV4",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Wrap the canonical trace used as a training audit sidecar.\n\nArgs:\n    reasoning: Exact six-section V4.6 trace.  V4.6 has no Finish object.",
  "properties": {
    "reasoning": {
      "$ref": "#/$defs/ReasoningTraceV4"
    }
  },
  "required": [
    "reasoning"
  ],
  "title": "ReasoningTargetV4",
  "type": "object"
}
