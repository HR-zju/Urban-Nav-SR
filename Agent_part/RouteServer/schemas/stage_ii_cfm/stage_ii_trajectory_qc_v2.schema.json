{
  "additionalProperties": false,
  "description": "Record raw-pose, temporal-coverage, and kinematic V2 QC.",
  "properties": {
    "clip_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Clip Id",
      "type": "string"
    },
    "dataset_source": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Source",
      "type": "string"
    },
    "frame_idx": {
      "minimum": 0,
      "title": "Frame Idx",
      "type": "integer"
    },
    "max_source_gap_sec": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Source Gap Sec"
    },
    "max_source_speed_mps": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Source Speed Mps"
    },
    "max_source_step_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Source Step M"
    },
    "max_source_yaw_rate_rad_s": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Source Yaw Rate Rad S"
    },
    "qc_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Qc Digest",
      "type": "string"
    },
    "raw_pose_count": {
      "minimum": 0,
      "title": "Raw Pose Count",
      "type": "integer"
    },
    "reason_codes": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "sample_id": {
      "maxLength": 480,
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "urbannav_stage_ii_trajectory_qc_v2_1",
      "default": "urbannav_stage_ii_trajectory_qc_v2_1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_adapter_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Source Adapter Id",
      "type": "string"
    },
    "source_evidence_digest": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Evidence Digest"
    },
    "source_horizon_seconds": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Horizon Seconds"
    },
    "source_valid_step_count": {
      "minimum": 0,
      "title": "Source Valid Step Count",
      "type": "integer"
    },
    "status": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_valid_step_count": {
      "maximum": 32,
      "minimum": 0,
      "title": "Target Valid Step Count",
      "type": "integer"
    },
    "trajectory_source": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Trajectory Source",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "dataset_source",
    "source_adapter_id",
    "trajectory_source",
    "clip_id",
    "frame_idx",
    "status",
    "reason_codes",
    "raw_pose_count",
    "source_valid_step_count",
    "target_valid_step_count",
    "qc_digest"
  ],
  "title": "StageIITrajectoryQCReportV2",
  "type": "object"
}
