{
  "$defs": {
    "BevRouteEvidenceV4": {
      "additionalProperties": false,
      "description": "Describe presentation properties of one prompt-visible BEV.\n\nThese fields are retained at the reusable observation boundary for VQA V2\ncompatibility.  Reasoning V4.6 never treats them as route-progress,\ntraversability, clearance, or collision-safety supervision.\n\nArgs:\n    frame: Declared BEV presentation frame.\n    ego_forward: Display direction corresponding to ego forward.\n    route_overlay_visible: Whether a route overlay is rendered.\n    route_direction_authority: Whether clear orientation may support a\n        visible task direction.\n    route_progress_authority: Legacy observation metadata ignored by\n        Reasoning V4.6.\n    route_terminal_marker_visible: Legacy presentation metadata ignored by\n        Reasoning V4.6.\n    route_endpoint_semantics: Legacy endpoint provenance ignored by\n        Reasoning V4.6.\n    local_safety_authority: Always false in Stage-A.\n    producer_contract_id: Versioned upstream producer identity.\n    producer_contract_version: Exact upstream producer version.",
      "properties": {
        "ego_forward": {
          "default": "unknown",
          "enum": [
            "up",
            "right",
            "down",
            "left",
            "unknown"
          ],
          "title": "Ego Forward",
          "type": "string"
        },
        "frame": {
          "default": "unknown",
          "enum": [
            "ego",
            "north_up",
            "unknown"
          ],
          "title": "Frame",
          "type": "string"
        },
        "local_safety_authority": {
          "const": false,
          "default": false,
          "title": "Local Safety Authority",
          "type": "boolean"
        },
        "producer_contract_id": {
          "default": "unknown",
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Contract Id",
          "type": "string"
        },
        "producer_contract_version": {
          "default": "unknown",
          "maxLength": 64,
          "minLength": 1,
          "title": "Producer Contract Version",
          "type": "string"
        },
        "route_direction_authority": {
          "default": "none",
          "enum": [
            "none",
            "visual_conditional"
          ],
          "title": "Route Direction Authority",
          "type": "string"
        },
        "route_endpoint_semantics": {
          "default": "unknown",
          "enum": [
            "planned_navigation_goal",
            "recorded_clip_endpoint",
            "crop_boundary",
            "unknown"
          ],
          "title": "Route Endpoint Semantics",
          "type": "string"
        },
        "route_overlay_visible": {
          "default": false,
          "title": "Route Overlay Visible",
          "type": "boolean"
        },
        "route_progress_authority": {
          "default": "none",
          "enum": [
            "none",
            "visual_conditional"
          ],
          "title": "Route Progress Authority",
          "type": "string"
        },
        "route_terminal_marker_visible": {
          "default": false,
          "title": "Route Terminal Marker Visible",
          "type": "boolean"
        }
      },
      "title": "BevRouteEvidenceV4",
      "type": "object"
    },
    "DirectionContextV4": {
      "additionalProperties": false,
      "description": "Select approved action and affordance-probe profiles.\n\nArgs:\n    action_profile_id: Canonical fine action-profile identifier.\n    action_profile_version: Exact action-profile version.\n    affordance_probe_profile_id: Canonical probe identifier.\n    affordance_probe_profile_version: Exact probe version.",
      "properties": {
        "action_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action Profile Id",
          "type": "string"
        },
        "action_profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Action Profile Version",
          "type": "string"
        },
        "affordance_probe_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Affordance Probe Profile Id",
          "type": "string"
        },
        "affordance_probe_profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Affordance Probe Profile Version",
          "type": "string"
        }
      },
      "required": [
        "action_profile_id",
        "action_profile_version",
        "affordance_probe_profile_id",
        "affordance_probe_profile_version"
      ],
      "title": "DirectionContextV4",
      "type": "object"
    },
    "DirectionSupervisionV4": {
      "additionalProperties": false,
      "description": "Carry one complete deterministic direction label.",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "bin_mode": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Bin Mode",
          "type": "string"
        },
        "choice": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "derivation_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Derivation Version",
          "type": "string"
        },
        "label_index": {
          "minimum": 0,
          "title": "Label Index",
          "type": "integer"
        },
        "label_name": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Label Name",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "source": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "label_index",
        "label_name",
        "choice",
        "source",
        "bin_mode",
        "derivation_version"
      ],
      "title": "DirectionSupervisionV4",
      "type": "object"
    },
    "EvidenceCatalogEntryV4": {
      "additionalProperties": false,
      "description": "Describe one prompt-visible raw input item.\n\nArgs:\n    ref: Stable input-envelope reference.\n    modality: Input modality.\n    summary: Optional prompt-visible summary.\n    attributes: Prompt-visible producer metadata.\n    bev_route_evidence: Optional BEV presentation declaration.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "bev_route_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/BevRouteEvidenceV4"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modality": {
          "enum": [
            "instruction",
            "fpv",
            "bev",
            "goal",
            "goal_image",
            "pixel_goal",
            "waypoint"
          ],
          "title": "Modality",
          "type": "string"
        },
        "ref": {
          "maxLength": 160,
          "minLength": 5,
          "pattern": "^(instruction|fpv|bev|goal|waypoint)\\.[a-z0-9_]+$",
          "title": "Ref",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "ref",
        "modality"
      ],
      "title": "EvidenceCatalogEntryV4",
      "type": "object"
    },
    "InputModalitiesV4": {
      "additionalProperties": false,
      "description": "Record which Stage-A inputs are present.\n\nArgs:\n    fpv: Current FPV is mandatory.\n    history_fpv: One or more history FPV images are input only.\n    instruction: An instruction is visible.\n    bev: A BEV image is visible.\n    goal_image: A goal image is visible.\n    pixel_goal: A pixel goal is visible.\n    waypoint: A waypoint is visible.",
      "properties": {
        "bev": {
          "default": false,
          "title": "Bev",
          "type": "boolean"
        },
        "fpv": {
          "const": true,
          "default": true,
          "title": "Fpv",
          "type": "boolean"
        },
        "goal_image": {
          "default": false,
          "title": "Goal Image",
          "type": "boolean"
        },
        "history_fpv": {
          "default": false,
          "title": "History Fpv",
          "type": "boolean"
        },
        "instruction": {
          "default": false,
          "title": "Instruction",
          "type": "boolean"
        },
        "pixel_goal": {
          "default": false,
          "title": "Pixel Goal",
          "type": "boolean"
        },
        "waypoint": {
          "default": false,
          "title": "Waypoint",
          "type": "boolean"
        }
      },
      "title": "InputModalitiesV4",
      "type": "object"
    },
    "StageIILossMaskV1": {
      "additionalProperties": false,
      "description": "Route one trajectory row exclusively to the System1 CFM objective.\n\nArgs:\n    lm: Always false because Pass T has no assistant text.\n    system1_action: Always true for the masked CFM objective.\n    trajectory: Always false for the legacy pixel trajectory head.\n    segmentation: Always false for the segmentation head.",
      "properties": {
        "lm": {
          "const": false,
          "default": false,
          "title": "Lm",
          "type": "boolean"
        },
        "segmentation": {
          "const": false,
          "default": false,
          "title": "Segmentation",
          "type": "boolean"
        },
        "system1_action": {
          "const": true,
          "default": true,
          "title": "System1 Action",
          "type": "boolean"
        },
        "trajectory": {
          "const": false,
          "default": false,
          "title": "Trajectory",
          "type": "boolean"
        }
      },
      "title": "StageIILossMaskV1",
      "type": "object"
    },
    "StageIITrajectoryPolicyV1": {
      "additionalProperties": false,
      "description": "Freeze metric target geometry and temporal resampling semantics.\n\nArgs:\n    policy_id: Canonical trajectory-policy identity.\n    policy_version: Exact policy version.\n    target_field: Physical target sidecar name.\n    target_format: Metric cumulative FLU pose format.\n    representation: Cumulative relative-pose representation.\n    coordinate_frame: Current-ego FLU frame.\n    axis_names: Ordered target axes.\n    units: Ordered target units.\n    horizon_steps: Fixed 16-step horizon.\n    horizon_seconds: Fixed two-second horizon.\n    target_dt_sec: Fixed 0.125-second grid interval.\n    temporal_resampling_id: Deterministic resampler stamp.\n    source_format: Exact supported timed source format.\n    trajectory_source: Dataset-owned source code.\n    yaw_source: Odometry or deterministic path tangent.\n    normalized: Always false at the canonical exchange boundary.",
      "properties": {
        "axis_names": {
          "default": [
            "x_forward_m",
            "y_left_m",
            "yaw_rel_ccw_rad"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "x_forward_m",
              "type": "string"
            },
            {
              "const": "y_left_m",
              "type": "string"
            },
            {
              "const": "yaw_rel_ccw_rad",
              "type": "string"
            }
          ],
          "title": "Axis Names",
          "type": "array"
        },
        "coordinate_frame": {
          "const": "current_ego_flu",
          "default": "current_ego_flu",
          "title": "Coordinate Frame",
          "type": "string"
        },
        "horizon_seconds": {
          "const": 2.0,
          "default": 2.0,
          "title": "Horizon Seconds",
          "type": "number"
        },
        "horizon_steps": {
          "const": 16,
          "default": 16,
          "title": "Horizon Steps",
          "type": "integer"
        },
        "normalized": {
          "const": false,
          "default": false,
          "title": "Normalized",
          "type": "boolean"
        },
        "policy_id": {
          "const": "urbannav_stage_ii_metric_flu_2s_16_v1",
          "default": "urbannav_stage_ii_metric_flu_2s_16_v1",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Policy Version",
          "type": "string"
        },
        "representation": {
          "const": "cumulative_relative_pose",
          "default": "cumulative_relative_pose",
          "title": "Representation",
          "type": "string"
        },
        "source_format": {
          "enum": [
            "ego_xy_t_speed_right_front_v1",
            "ego_pose_xyt_flu_timed_v1"
          ],
          "title": "Source Format",
          "type": "string"
        },
        "target_dt_sec": {
          "const": 0.125,
          "default": 0.125,
          "title": "Target Dt Sec",
          "type": "number"
        },
        "target_field": {
          "const": "trajectory_ego_t",
          "default": "trajectory_ego_t",
          "title": "Target Field",
          "type": "string"
        },
        "target_format": {
          "const": "ego_pose_xyt_flu_v1",
          "default": "ego_pose_xyt_flu_v1",
          "title": "Target Format",
          "type": "string"
        },
        "temporal_resampling_id": {
          "const": "linear_time_grid_2s_16_v1",
          "default": "linear_time_grid_2s_16_v1",
          "title": "Temporal Resampling Id",
          "type": "string"
        },
        "trajectory_source": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Trajectory Source",
          "type": "string"
        },
        "units": {
          "default": [
            "meter",
            "meter",
            "radian"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "meter",
              "type": "string"
            },
            {
              "const": "meter",
              "type": "string"
            },
            {
              "const": "radian",
              "type": "string"
            }
          ],
          "title": "Units",
          "type": "array"
        },
        "yaw_source": {
          "enum": [
            "odometry",
            "path_tangent"
          ],
          "title": "Yaw Source",
          "type": "string"
        }
      },
      "required": [
        "source_format",
        "trajectory_source",
        "yaw_source"
      ],
      "title": "StageIITrajectoryPolicyV1",
      "type": "object"
    },
    "StageIITrajectoryTargetV1": {
      "additionalProperties": false,
      "description": "Carry one metric FLU trajectory and its prefix-contiguous valid mask.\n\nArgs:\n    schema_version: Exact target schema stamp.\n    trajectory_ego_t: Metric cumulative FLU poses shaped ``[16,3]``.\n    action_mask: Non-empty valid prefix followed by optional padding.\n    valid_step_count: Number of true mask entries.\n    policy: Frozen source/frame/time contract.\n    source_target_digest: Digest of raw source rows and declarations.\n    target_digest: SHA-256 over all other target fields.",
      "properties": {
        "action_mask": {
          "items": {
            "type": "boolean"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Action Mask",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/StageIITrajectoryPolicyV1"
        },
        "schema_version": {
          "const": "urbannav_stage_ii_trajectory_target_v1",
          "default": "urbannav_stage_ii_trajectory_target_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_target_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Target Digest",
          "type": "string"
        },
        "target_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Digest",
          "type": "string"
        },
        "trajectory_ego_t": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Trajectory Ego T",
          "type": "array"
        },
        "valid_step_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Valid Step Count",
          "type": "integer"
        }
      },
      "required": [
        "trajectory_ego_t",
        "action_mask",
        "valid_step_count",
        "policy",
        "source_target_digest",
        "target_digest"
      ],
      "title": "StageIITrajectoryTargetV1",
      "type": "object"
    },
    "StageIModalityAvailabilityV1": {
      "additionalProperties": false,
      "description": "Record native optional-modality availability before training dropout.\n\nArgs:\n    current_fpv: Current FPV is mandatory for every Stage I view.\n    history_fpv: At least one history FPV image is native input.\n    instruction: A prompt-visible instruction is native input.\n    bev: A prompt-visible BEV image is native input.\n    goal_image: A goal image exists but is unsupported in Stage I v1.\n    pixel_goal: A pixel goal exists but is unsupported in Stage I v1.\n    waypoint: A waypoint exists but is dormant in Stage I v1.",
      "properties": {
        "bev": {
          "default": false,
          "title": "Bev",
          "type": "boolean"
        },
        "current_fpv": {
          "const": true,
          "default": true,
          "title": "Current Fpv",
          "type": "boolean"
        },
        "goal_image": {
          "default": false,
          "title": "Goal Image",
          "type": "boolean"
        },
        "history_fpv": {
          "default": false,
          "title": "History Fpv",
          "type": "boolean"
        },
        "instruction": {
          "default": false,
          "title": "Instruction",
          "type": "boolean"
        },
        "pixel_goal": {
          "default": false,
          "title": "Pixel Goal",
          "type": "boolean"
        },
        "waypoint": {
          "default": false,
          "title": "Waypoint",
          "type": "boolean"
        }
      },
      "title": "StageIModalityAvailabilityV1",
      "type": "object"
    },
    "StageIModalitySelectionV1": {
      "additionalProperties": false,
      "description": "Record the optional modalities retained by one training view.\n\nArgs:\n    current_fpv: Current FPV is always retained.\n    history_fpv: Retain native history FPV images.\n    instruction: Retain the native instruction.\n    bev: Retain native BEV images.\n    goal_image: Always false in Stage I v1.\n    pixel_goal: Always false in Stage I v1.\n    waypoint: Always false in Stage I v1.",
      "properties": {
        "bev": {
          "default": false,
          "title": "Bev",
          "type": "boolean"
        },
        "current_fpv": {
          "const": true,
          "default": true,
          "title": "Current Fpv",
          "type": "boolean"
        },
        "goal_image": {
          "const": false,
          "default": false,
          "title": "Goal Image",
          "type": "boolean"
        },
        "history_fpv": {
          "default": false,
          "title": "History Fpv",
          "type": "boolean"
        },
        "instruction": {
          "default": false,
          "title": "Instruction",
          "type": "boolean"
        },
        "pixel_goal": {
          "const": false,
          "default": false,
          "title": "Pixel Goal",
          "type": "boolean"
        },
        "waypoint": {
          "const": false,
          "default": false,
          "title": "Waypoint",
          "type": "boolean"
        }
      },
      "title": "StageIModalitySelectionV1",
      "type": "object"
    },
    "StageIModalityStateV1": {
      "additionalProperties": false,
      "description": "Expose whether each optional modality is present, absent, or dropped.\n\nArgs:\n    history_fpv: State of history FPV.\n    instruction: State of the instruction.\n    bev: State of BEV.\n    goal_image: State of goal-image input.\n    pixel_goal: State of pixel-goal input.\n    waypoint: State of waypoint input.",
      "properties": {
        "bev": {
          "enum": [
            "present",
            "native_missing",
            "training_dropout"
          ],
          "title": "Bev",
          "type": "string"
        },
        "goal_image": {
          "enum": [
            "present",
            "native_missing",
            "training_dropout"
          ],
          "title": "Goal Image",
          "type": "string"
        },
        "history_fpv": {
          "enum": [
            "present",
            "native_missing",
            "training_dropout"
          ],
          "title": "History Fpv",
          "type": "string"
        },
        "instruction": {
          "enum": [
            "present",
            "native_missing",
            "training_dropout"
          ],
          "title": "Instruction",
          "type": "string"
        },
        "pixel_goal": {
          "enum": [
            "present",
            "native_missing",
            "training_dropout"
          ],
          "title": "Pixel Goal",
          "type": "string"
        },
        "waypoint": {
          "enum": [
            "present",
            "native_missing",
            "training_dropout"
          ],
          "title": "Waypoint",
          "type": "string"
        }
      },
      "required": [
        "history_fpv",
        "instruction",
        "bev",
        "goal_image",
        "pixel_goal",
        "waypoint"
      ],
      "title": "StageIModalityStateV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exchange one current-V4 direct-latent Pass-T row.\n\nThis profile deliberately contains no Pass-R or Pass-D cache.  It is the\ndirect-latent baseline for measuring whether the frozen Stage-I visual and\nlanguage representation alone can condition the isolated trajectory\nqueries.  The metric trajectory and strong direction remain private\nsidecars and never become prompt text.\n\nArgs:\n    schema_version: Exact direct-latent exchange schema stamp.\n    training_contract: Shared CFM-V1 math contract.\n    direct_latent_profile_id: Current-V4 cacheless profile identity.\n    direct_latent_profile_version: Exact direct-latent profile version.\n    sample_id: Unique direct-latent Stage-II row identity.\n    source_group_id: Parent source group.\n    split_group_id: Leakage-safe split group.\n    dataset_source: Dataset family.\n    modality_profile_id: Exact student-visible modality profile.\n    native_availability: Native optional-modality availability.\n    training_selection: Modalities retained by this projection.\n    modality_state: Native/dropout state for every modality.\n    instruction_training_role: Frozen instruction provenance.\n    images: Ordered model-visible media references.\n    image_roles: One semantic role per image.\n    instruction: Optional model-visible instruction.\n    model_visible_context: Additional safe visible context.\n    evidence_catalog: Prompt-visible evidence inventory.\n    input_modalities: Canonical modality flags.\n    projected_input_digest: Digest of the exact visible observation.\n    trajectory_target: Private metric CFM truth.\n    direction_context: Public action vocabulary only.\n    private_direction_supervision: Private sampler/evaluator stamp.\n    parent_stage_i_sample_id: Formal V4 FullCoT parent identity.\n    parent_source_fingerprint: Immutable parent source fingerprint.\n    parent_audit_id: Resolved action-reconciliation audit.\n    formal_training_eligible: Formal admission marker.\n    review_status: Completed human-review state.\n    loss_mask: CFM-only loss route.\n    projection_policy_id: Direct-latent projection policy identity.\n    projection_policy_version: Direct-latent projection policy version.\n    view_digest: SHA-256 over all other view fields.",
  "properties": {
    "dataset_source": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Source",
      "type": "string"
    },
    "direct_latent_profile_id": {
      "const": "reasoning_v4_6_direct_latent_v1",
      "default": "reasoning_v4_6_direct_latent_v1",
      "title": "Direct Latent Profile Id",
      "type": "string"
    },
    "direct_latent_profile_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Direct Latent Profile Version",
      "type": "string"
    },
    "direction_context": {
      "$ref": "#/$defs/DirectionContextV4"
    },
    "evidence_catalog": {
      "items": {
