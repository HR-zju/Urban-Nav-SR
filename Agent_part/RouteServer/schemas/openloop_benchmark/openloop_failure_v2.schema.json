{
  "additionalProperties": false,
  "description": "Record one benchmark attempt that did not produce a prediction.\n\nArgs:\n    sample_id: Exact benchmark row identity.\n    parent_sample_id: Exact physical-sample identity.\n    stage: Benchmark stage.\n    task_type: Atomic task family.\n    attempted_pass: Pass at which the attempt failed.\n    failure_code: Stable bounded failure category.\n    detail: Optional bounded diagnostic, never a traceback dump.\n    retry_attempted: Whether the run retried the sample.\n    input_digest: Digest of the attempted model-visible input.",
  "properties": {
    "attempted_pass": {
      "enum": [
        "stage_i_generation",
        "pass_r",
        "pass_d",
        "pass_t",
        "evaluation"
      ],
      "title": "Attempted Pass",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "failure_code": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Failure Code",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "parent_sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Parent Sample Id",
      "type": "string"
    },
    "retry_attempted": {
      "default": false,
      "title": "Retry Attempted",
      "type": "boolean"
    },
    "sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "default": "urbannav_openloop_failure_v2_1",
      "enum": [
        "urbannav_openloop_failure_v2_1",
        "urbannav_openloop_failure_v2_0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "enum": [
        "stage_i",
        "stage_ii"
      ],
      "title": "Stage",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "full_cot",
        "vqa",
        "decision",
        "reasoning_dropout",
        "trajectory"
      ],
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "parent_sample_id",
    "stage",
    "task_type",
    "attempted_pass",
    "failure_code",
    "input_digest"
  ],
  "title": "OpenLoopFailureV1",
  "type": "object"
}
