    "san_francisco_downtown": "san_francisco_downtown.jsonl",
    "chicago_loop": "chicago_loop.jsonl",
    "toronto_downtown": "toronto_downtown.jsonl",
    "london_soho": "london_soho.jsonl",
    "paris_latin_quarter": "paris_latin_quarter.jsonl",
    "berlin_mitte": "berlin_mitte.jsonl",
    "amsterdam_centrum": "amsterdam_centrum.jsonl",
    "barcelona_eixample": "barcelona_eixample.jsonl",
    "tokyo_shinjuku": "tokyo_shinjuku.jsonl",
    "osaka_namba": "osaka_namba.jsonl",
    "seoul_myeongdong": "seoul_myeongdong.jsonl",
    "singapore_orchard": "singapore_orchard.jsonl",
    "bangkok_siam": "bangkok_siam.jsonl",
    "sydney_cbd": "sydney_cbd.jsonl",
    "mexico_city_roma": "mexico_city_roma.jsonl",
    "sao_paulo_paulista": "sao_paulo_paulista.jsonl"
